<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymMangmentSystem01</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymMangmentSystem01.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/assets/css/route.css" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">R</span>
                <span class="brand-text">
                    <span class="brand-name">ROUTE</span>
                    <span class="brand-sub">Gym Management</span>
                </span>
            </a>

            <nav>
                <div class="nav-group">
                    <div class="nav-label">Overview</div>
                    <a class="nav-link-r" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                </div>
                <div class="nav-group">
                    <div class="nav-label">People</div>
                    <!-- BACKEND: Member / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-people"></i> Members</a>
                    <!-- BACKEND: Trainer / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-person-badge"></i> Trainers</a>
                </div>
                <div class="nav-group">
                    <div class="nav-label">Gym</div>
                    <a class="nav-link-r" asp-controller="Plan" asp-action="Index"><i class="bi bi-tags"></i> Plans</a>
                    <!-- BACKEND: Membership / Index  -->
                    <a class="nav-link-r" href="#"><i class="bi bi-card-checklist"></i> Memberships</a>
                    <!-- BACKEND: Session / Index -->
                    <a class="nav-link-r" href="#"><i class="bi bi-calendar-week"></i> Sessions</a>
                </div>
            </nav>

            <div class="sidebar-foot">
                <span class="track-chip">.NET Track</span>
                <span>Route Academy</span>
            </div>
        </aside>
        <div class="scrim" data-nav-toggle></div>

        <div class="main">
            <header class="topbar">
                <button class="burger" type="button" data-nav-toggle aria-label="Open menu"><i class="bi bi-list"></i></button>
                <div class="crumbs">
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i></a>
                    <span class="sep">/</span>
                    <span class="here">@ViewData["Title"]</span>
                </div>
                <div class="topbar-right">
                    <span class="date-chip"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, d MMM yyyy")</span>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/site.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
